rules_version = '2';

// כללי אבטחה ל-Firestore: כל שחקן/ית יכולים לקרוא ולכתוב רק למסמך
// ההתקדמות האישי שלהם (players/{uid}), ולחדרי רב-משתתפים בהתאם
// לתפקידם - ראו docs/FIREBASE_SETUP.md לפירוט המלא.
//
// מודל האבטחה למצב "משחק מול חברים" הוא client-trusted: אין Cloud
// Functions, כל שחקן/ית כותב/ת רק לניקוד של עצמו/ה (מאומת מקומית מול
// הלוח/המילון, בדיוק כמו במשחק יחיד-שחקן). החוקים כאן אוכפים בעלות,
// מונוטוניות ניקוד, ומעברי סטטוס חוקיים בלבד - לא מחליפים אימות שרת
// אמיתי, וזו החלטה מודעת המתאימה למשחק מזדמן מול חברים (ראו התוכנית).
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // עזרים
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    function optShortText(v, max) {
      return v == null || shortText(v, max);
    }

    // תמונת פרופיל מותרת רק מהשרתים של ספקי ההתחברות - כדי שאי אפשר יהיה
    // להציג לשחקנים אחרים תמונה פוגענית או "פיקסל מעקב" מכתובת שרירותית.
    function validPhoto(v) {
      return v == null || (
        v is string
        && v.size() <= 2048
        && v.matches('https://([a-z0-9-]+[.])*(googleusercontent[.]com|ggpht[.]com|fbcdn[.]net|facebook[.]com|fbsbx[.]com)/.*')
      );
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function absent(d, key) {
      return !(key in d);
    }

    function _roomConfigUnchanged(next, prev) {
      return next.hostUid == prev.hostUid
        && next.gridSize == prev.gridSize
        && next.boardSeed == prev.boardSeed
        && next.roundSeconds == prev.roundSeconds
        && next.targetScore == prev.targetScore
        && next.maxPlayers == prev.maxPlayers
        && next.totalRounds == prev.totalRounds
        && next.currentRound == prev.currentRound
        && next.entryFee == prev.entryFee;
    }

    function _potLocked(next, prev) {
      return next.pot == prev.pot
        && next.paidUids == prev.paidUids;
    }

    // הנמען/ת חסמ/ה את השולח/ת? (exists בחוקים לא כפוף להרשאות הקריאה.)
    function notBlockedBy(targetUid) {
      return !exists(/databases/$(database)/documents/blocks/$(targetUid)/users/$(request.auth.uid));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------------
    // התקדמות פרטית. המשחק יחיד-השחקן מאומת בלקוח (אין Cloud Functions),
    // אז כאן רק גבולות שפיות: טיפוסים, טווחים וגודל מסמך סביר.
    // ---------------------------------------------------------------------
    function validProgress(d) {
      return d.keys().size() <= 64
        && (absent(d, 'coins') || intIn(d.coins, 0, 100000000))
        && (absent(d, 'hints') || intIn(d.hints, 0, 1000000))
        && (absent(d, 'highestUnlockedLevel') || intIn(d.highestUnlockedLevel, 0, 100000))
        && (absent(d, 'displayName') || optShortText(d.displayName, 200))
        && (absent(d, 'levelProgress') || (d.levelProgress is map && d.levelProgress.size() <= 5000));
    }

    match /players/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && validProgress(request.resource.data);
    }

    // ---------------------------------------------------------------------
    // חברים: כרטיס ציבורי, רשימת חברים, בקשות חברות והזמנות למשחק.
    // ---------------------------------------------------------------------

    function validPublicProfile(d) {
      return d.keys().size() <= 32
        && (absent(d, 'displayName') || shortText(d.displayName, 40))
        && (absent(d, 'displayNameLower') || shortText(d.displayNameLower, 40))
        && (absent(d, 'avatarId') || optShortText(d.avatarId, 40))
        && (absent(d, 'photoUrl') || validPhoto(d.photoUrl))
        && (absent(d, 'friendCode') || shortText(d.friendCode, 12))
        && (absent(d, 'status') || d.status in ['online', 'playing', 'offline'])
        && (absent(d, 'totalStars') || intIn(d.totalStars, 0, 100000))
        && (absent(d, 'highestLevel') || intIn(d.highestLevel, 0, 100000))
        && (absent(d, 'dailyDate') || optShortText(d.dailyDate, 16))
        && (absent(d, 'dailyScore') || intIn(d.dailyScore, 0, 1000000))
        && (absent(d, 'dailyStreak') || intIn(d.dailyStreak, 0, 100000))
        && (absent(d, 'mpGames') || intIn(d.mpGames, 0, 10000000))
        && (absent(d, 'mpWins') || intIn(d.mpWins, 0, 10000000));
    }

    function validFriendEntry(d) {
      return d.keys().hasOnly(['since', 'wins', 'losses', 'games', 'lastPlayed'])
        && (absent(d, 'wins') || intIn(d.wins, 0, 10000000))
        && (absent(d, 'losses') || intIn(d.losses, 0, 10000000))
        && (absent(d, 'games') || intIn(d.games, 0, 10000000));
    }

    // הכרטיס הציבורי (שם, אוואטאר, קוד חבר, כוכבים, נוכחות) - גלוי לכל
    // משתמש/ת מחובר/ת (כדי לחפש לפי קוד חבר ולראות שחקנים בחדר), אבל רק
    // הבעלים יכול/ה לכתוב אותו. שאילתות מוגבלות ל-30 תוצאות, כדי שאי אפשר
    // יהיה למשוך את כל השחקנים בבת אחת.
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 30;
      allow create, update: if isUser(uid) && validPublicProfile(request.resource.data);
      allow delete: if isUser(uid);

      // הרשומה שלי על כל חבר/ה (ממתי חברים, מאזן ראש בראש).
      match /friends/{friendUid} {
        allow read: if isUser(uid);
        // רשומה חדשה נוצרת רק כשיש בקשת חברות בין שני הצדדים (בכל כיוון) -
        // אי אפשר "להוסיף" מישהו לחברים בלי שהוא שלח או קיבל בקשה.
        allow create: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid)
          && uid != friendUid
          && validFriendEntry(request.resource.data)
          && (
            exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))
            || exists(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid))
          );
        // הבעלים מעדכנ/ת את המאזן; הצד השני רק בזמן אישור בקשה.
        allow update: if signedIn()
          && validFriendEntry(request.resource.data)
          && (
            request.auth.uid == uid
            || (
              request.auth.uid == friendUid
              && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))
            )
          );
        // ביטול חברות - כל צד יכול להסיר את הקשר משני הכיוונים.
        allow delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    // רשימת החסומים שלי - רק אני קורא/ת וכותב/ת.
    match /blocks/{uid}/users/{blockedUid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && blockedUid != uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && optShortText(request.resource.data.get('name', null), 40)
        && request.resource.data.createdAt == request.time;
    }

    // דיווחים על משתמשים: כתיבה בלבד (הצוות קורא אותם מקונסולת Firebase).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'reported', 'reportedName', 'reason', 'context', 'status', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.reported is string
        && request.resource.data.reported != request.auth.uid
        && shortText(request.resource.data.reportedName, 40)
        && request.resource.data.reason in ['offensive_name', 'harassment', 'spam', 'cheating', 'other']
        && shortText(request.resource.data.context, 200)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    match /friendRequests/{requestId} {
      // get של בקשה שלא קיימת (בדיקה "האם הצד השני כבר ביקש ממני?") חייב
      // לעבור - אחרת כל בקשת חברות נכשלת. מסמך שלא קיים לא חושף כלום.
      allow get: if signedIn()
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromAvatarId', 'fromPhotoUrl', 'toName', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && shortText(request.resource.data.fromName, 40)
        && optShortText(request.resource.data.get('fromAvatarId', null), 40)
        && validPhoto(request.resource.data.get('fromPhotoUrl', null))
        && optShortText(request.resource.data.get('toName', null), 40)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to))
        && notBlockedBy(request.resource.data.to);
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // הזמנה רק לחדר שהשולח/ת נמצא/ת בו, עם שדות מוגדרים ובגודל סביר.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromAvatarId', 'fromPhotoUrl', 'toName', 'roomCode', 'gridSize', 'roundSeconds', 'entryFee', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && shortText(request.resource.data.fromName, 40)
        && optShortText(request.resource.data.get('fromAvatarId', null), 40)
        && validPhoto(request.resource.data.get('fromPhotoUrl', null))
        && optShortText(request.resource.data.get('toName', null), 40)
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('[0-9]{5}')
        && intIn(request.resource.data.gridSize, 3, 8)
        && intIn(request.resource.data.roundSeconds, 10, 3600)
        && request.resource.data.entryFee in [5, 10, 20, 50]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/players/$(request.auth.uid))
        && notBlockedBy(request.resource.data.to);
      // הנמען/ת עונה (מאשר/ת או דוחה) - משנים רק את הסטטוס ואת זמן התשובה.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.status in ['accepted', 'declined']
        && changedOnly(['status', 'respondedAt']);
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /rooms/{roomCode} {
      // קריאה לפי קוד בלבד. אין רשימה של כל החדרים - אחרת כל אחד יכול היה
      // לראות את כל הקודים ולהצטרף לחדרים פרטיים של זרים.
      allow get: if signedIn();
      allow list: if false;

      // יצירת חדר: רק מי שמצהיר/ה על עצמו/ה כמנהל/ת (hostUid == המשתמש/ת
      // המבצע/ת את הכתיבה), עם שדות הגדרה מהסוג הנכון.
      allow create: if signedIn()
        && roomCode.matches('[0-9]{5}')
        && request.resource.data.keys().hasOnly(['status', 'hostUid', 'gridSize', 'boardSeed', 'roundSeconds', 'targetScore', 'maxPlayers', 'totalRounds', 'currentRound', 'entryFee', 'pot', 'paidUids', 'potAwarded', 'joinDeadline', 'startedAt', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && intIn(request.resource.data.gridSize, 3, 8)
        && request.resource.data.boardSeed is int
        && intIn(request.resource.data.roundSeconds, 10, 3600)
        && intIn(request.resource.data.targetScore, 0, 1000000)
        && intIn(request.resource.data.maxPlayers, 2, 10)
        && request.resource.data.totalRounds is int
        && request.resource.data.paidUids is map
        && request.resource.data.paidUids.keys().hasOnly([request.auth.uid])
        && request.resource.data.paidUids[request.auth.uid] == true
        && request.resource.data.joinDeadline is timestamp
        && request.resource.data.startedAt == null
        && request.resource.data.totalRounds >= 1
        && request.resource.data.totalRounds <= 10
        && request.resource.data.currentRound == 1
        && request.resource.data.entryFee in [5, 10, 20, 50]
        && request.resource.data.pot == request.resource.data.entryFee
        && request.resource.data.potAwarded == false;

      // עדכון: מעברי סטטוס חוקיים, עדכוני קופה בהצטרפות/יציאה מלובי,
      // וכל שדות ההגדרה נעולים (חוץ מ-boardSeed/currentRound בסבב הבא).
      allow update: if signedIn() && (
        // המנהל/ת מתחיל/ה את המשחק.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'inProgress'
          && request.auth.uid == resource.data.hostUid
          && changedOnly(['status', 'startedAt'])
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && _potLocked(request.resource.data, resource.data)
        )
        ||
        // כל חבר/ת בחדר יכול/ה לסמן שהסבב הסתיים (זמן נגמר / ניקוד יעד
        // הושג) - מונה הניצחונות (wins) ו-potAwarded חופשיים להשתנות כאן.
        (
          resource.data.status == 'inProgress'
          && request.resource.data.status == 'finished'
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid))
          && changedOnly(['status', 'wins', 'potAwarded'])
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && _potLocked(request.resource.data, resource.data)
        )
        ||
        // "משחק חוזר": רק המנהל/ת, ורק מסבב שהסתיים - לוח חדש (boardSeed
        // אחר) אך כל שאר הגדרות המשחק ומונה הניצחונות המצטבר נשמרים.
        (
          resource.data.status == 'finished'
          && request.resource.data.status == 'waiting'
          && request.auth.uid == resource.data.hostUid
          && changedOnly(['status', 'boardSeed', 'startedAt'])
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.gridSize == resource.data.gridSize
          && request.resource.data.roundSeconds == resource.data.roundSeconds
          && request.resource.data.targetScore == resource.data.targetScore
          && request.resource.data.maxPlayers == resource.data.maxPlayers
          && request.resource.data.totalRounds == resource.data.totalRounds
          && request.resource.data.currentRound == resource.data.currentRound
          && request.resource.data.entryFee == resource.data.entryFee
          && request.resource.data.boardSeed is int
          && request.resource.data.startedAt == null
        )
        ||
        // הסבב הבא בסדרה: finished → inProgress, currentRound + 1, לוח חדש.
        (
          resource.data.status == 'finished'
          && request.resource.data.status == 'inProgress'
          && request.auth.uid == resource.data.hostUid
          && changedOnly(['status', 'boardSeed', 'startedAt', 'currentRound'])
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.gridSize == resource.data.gridSize
          && request.resource.data.roundSeconds == resource.data.roundSeconds
          && request.resource.data.targetScore == resource.data.targetScore
          && request.resource.data.maxPlayers == resource.data.maxPlayers
          && request.resource.data.totalRounds == resource.data.totalRounds
          && request.resource.data.entryFee == resource.data.entryFee
          && request.resource.data.pot == resource.data.pot
          && request.resource.data.currentRound == resource.data.currentRound + 1
          && request.resource.data.currentRound <= resource.data.totalRounds
          && request.resource.data.boardSeed is int
          && request.resource.data.startedAt != null
        )
        ||
        // הצטרפות: הגדלת הקופה בדיוק בדמי הכניסה והוספת המשלם/ת.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && changedOnly(['pot', 'paidUids'])
          && request.resource.data.paidUids.diff(resource.data.paidUids).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.pot == resource.data.pot + resource.data.entryFee
          && request.resource.data.paidUids[request.auth.uid] == true
        )
        ||
        // יציאה מהלובי לפני התחלה: הקטנת הקופה והסרת המשלם/ת.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && changedOnly(['pot', 'paidUids'])
          && request.resource.data.paidUids.diff(resource.data.paidUids).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.paidUids)
          && resource.data.paidUids[request.auth.uid] == true
          && request.resource.data.pot == resource.data.pot - resource.data.entryFee
        )
      );

      match /players/{uid} {
        allow read: if signedIn();
        // הצטרפות: רק לעצמי, רק לחדר שמחכה לשחקנים, ותמיד מאפס.
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['displayName', 'score', 'wordsFound', 'isHost', 'avatarId', 'photoUrl', 'joinedAt'])
          && shortText(request.resource.data.displayName, 40)
          && request.resource.data.score == 0
          && request.resource.data.wordsFound == 0
          && request.resource.data.isHost == (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == uid)
          && optShortText(request.resource.data.get('avatarId', null), 40)
          && validPhoto(request.resource.data.get('photoUrl', null))
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == 'waiting';
        // עדכון: או בעל/ת המסמך מעדכנ/ת ניקוד עצמי בלבד (מונוטוני ובגבולות
        // סבירים), או מנהל/ת החדר מאפס/ת ניקוד לכולם בעת "משחק חוזר" /
        // סבב הבא (ראו rooms/{roomCode} allow update למעלה).
        allow update: if signedIn() && changedOnly(['score', 'wordsFound']) && (
          (
            request.auth.uid == uid
            && intIn(request.resource.data.score, resource.data.score, 1000000)
            && intIn(request.resource.data.wordsFound, resource.data.wordsFound, 10000)
          )
          ||
          (
            get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            && request.resource.data.score == 0
            && request.resource.data.wordsFound == 0
          )
        );
        allow delete: if isUser(uid);
      }
    }
  }
}
