rules_version = '2';

// כללי אבטחה ל-Firestore: כל שחקן/ית יכולים לקרוא ולכתוב רק למסמך
// ההתקדמות האישי שלהם (players/{uid}), ולחדרי רב-משתתפים בהתאם
// לתפקידם - ראו docs/FIREBASE_SETUP.md לפירוט המלא.
//
// מודל האבטחה למצב "משחק מול חברים" הוא client-trusted: אין Cloud
// Functions, כל שחקן/ית כותב/ת רק לניקוד של עצמו/ה (מאומת מקומית מול
// הלוח/המילון, בדיוק כמו במשחק יחיד-שחקן). החוקים כאן אוכפים בעלות,
// מונוטוניות ניקוד, ומעברי סטטוס חוקיים בלבד - לא מחליפים אימות שרת
// אמיתי, וזו החלטה מודעת המתאימה למשחק מזדמן מול חברים (ראו התוכנית).
service cloud.firestore {
  match /databases/{database}/documents {
    function _roomConfigUnchanged(next, prev) {
      return next.hostUid == prev.hostUid
        && next.gridSize == prev.gridSize
        && next.boardSeed == prev.boardSeed
        && next.roundSeconds == prev.roundSeconds
        && next.targetScore == prev.targetScore
        && next.maxPlayers == prev.maxPlayers
        && next.totalRounds == prev.totalRounds
        && next.currentRound == prev.currentRound
        && next.entryFee == prev.entryFee;
    }

    function _potLocked(next, prev) {
      return next.pot == prev.pot
        && next.paidUids == prev.paidUids;
    }

    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // חברים: כרטיס ציבורי, רשימת חברים, בקשות חברות והזמנות למשחק.
    // ---------------------------------------------------------------------

    // הכרטיס הציבורי (שם, אוואטאר, קוד חבר, כוכבים, נוכחות) - גלוי לכל
    // משתמש/ת מחובר/ת (כדי לחפש לפי קוד חבר ולראות שחקנים בחדר), אבל רק
    // הבעלים יכול/ה לכתוב אותו. הנתונים הפרטיים נשארים ב-players/{uid}.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40));
      allow delete: if request.auth != null && request.auth.uid == uid;

      // הרשומה שלי על כל חבר/ה (ממתי חברים, מאזן ראש בראש).
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // הבעלים מנהל/ת את הרשימה שלו/ה; צד שני יכול להוסיף את עצמו
        // לרשימה שלי רק כשהוא מאשר בקשה שאני שלחתי אליו.
        allow create, update: if request.auth != null && (
          request.auth.uid == uid
          || (
            request.auth.uid == friendUid
            && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))
          )
        );
        // ביטול חברות - כל צד יכול להסיר את הקשר משני הכיוונים.
        allow delete: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.roomCode is string
        && request.resource.data.status == 'pending';
      // הנמען/ת עונה (מאשר/ת או דוחה) - משנים רק את הסטטוס ואת זמן התשובה.
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      // יצירת חדר: רק מי שמצהיר/ה על עצמו/ה כמנהל/ת (hostUid == המשתמש/ת
      // המבצע/ת את הכתיבה), עם שדות הגדרה מהסוג הנכון.
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.gridSize is int
        && request.resource.data.boardSeed is int
        && request.resource.data.roundSeconds is int
        && request.resource.data.targetScore is int
        && request.resource.data.maxPlayers is int
        && request.resource.data.totalRounds is int
        && request.resource.data.totalRounds >= 1
        && request.resource.data.totalRounds <= 10
        && request.resource.data.currentRound == 1
        && request.resource.data.entryFee in [5, 10, 20, 50]
        && request.resource.data.pot == request.resource.data.entryFee
        && request.resource.data.potAwarded == false;

      // עדכון: מעברי סטטוס חוקיים, עדכוני קופה בהצטרפות/יציאה מלובי,
      // וכל שדות ההגדרה נעולים (חוץ מ-boardSeed/currentRound בסבב הבא).
      allow update: if request.auth != null && (
        // המנהל/ת מתחיל/ה את המשחק.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'inProgress'
          && request.auth.uid == resource.data.hostUid
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && _potLocked(request.resource.data, resource.data)
        )
        ||
        // כל חבר/ת בחדר יכול/ה לסמן שהסבב הסתיים (זמן נגמר / ניקוד יעד
        // הושג) - מונה הניצחונות (wins) ו-potAwarded חופשיים להשתנות כאן.
        (
          resource.data.status == 'inProgress'
          && request.resource.data.status == 'finished'
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid))
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && _potLocked(request.resource.data, resource.data)
        )
        ||
        // "משחק חוזר": רק המנהל/ת, ורק מסבב שהסתיים - לוח חדש (boardSeed
        // אחר) אך כל שאר הגדרות המשחק ומונה הניצחונות המצטבר נשמרים.
        (
          resource.data.status == 'finished'
          && request.resource.data.status == 'waiting'
          && request.auth.uid == resource.data.hostUid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.gridSize == resource.data.gridSize
          && request.resource.data.roundSeconds == resource.data.roundSeconds
          && request.resource.data.targetScore == resource.data.targetScore
          && request.resource.data.maxPlayers == resource.data.maxPlayers
          && request.resource.data.totalRounds == resource.data.totalRounds
          && request.resource.data.currentRound == resource.data.currentRound
          && request.resource.data.entryFee == resource.data.entryFee
          && request.resource.data.boardSeed is int
          && request.resource.data.startedAt == null
        )
        ||
        // הסבב הבא בסדרה: finished → inProgress, currentRound + 1, לוח חדש.
        (
          resource.data.status == 'finished'
          && request.resource.data.status == 'inProgress'
          && request.auth.uid == resource.data.hostUid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.gridSize == resource.data.gridSize
          && request.resource.data.roundSeconds == resource.data.roundSeconds
          && request.resource.data.targetScore == resource.data.targetScore
          && request.resource.data.maxPlayers == resource.data.maxPlayers
          && request.resource.data.totalRounds == resource.data.totalRounds
          && request.resource.data.entryFee == resource.data.entryFee
          && request.resource.data.pot == resource.data.pot
          && request.resource.data.currentRound == resource.data.currentRound + 1
          && request.resource.data.currentRound <= resource.data.totalRounds
          && request.resource.data.boardSeed is int
          && request.resource.data.startedAt != null
        )
        ||
        // הצטרפות: הגדלת הקופה בדיוק בדמי הכניסה והוספת המשלם/ת.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && request.resource.data.pot == resource.data.pot + resource.data.entryFee
          && request.resource.data.paidUids[request.auth.uid] == true
        )
        ||
        // יציאה מהלובי לפני התחלה: הקטנת הקופה והסרת המשלם/ת.
        (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && _roomConfigUnchanged(request.resource.data, resource.data)
          && resource.data.paidUids[request.auth.uid] == true
          && request.resource.data.pot == resource.data.pot - resource.data.entryFee
        )
      );

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        // עדכון: או בעל/ת המסמך מעדכנ/ת ניקוד עצמי בלבד (מונוטוני, בלי
        // לשנות שם/תפקיד), או מנהל/ת החדר מאפס/ת ניקוד לכולם בעת "משחק
        // חוזר" / סבב הבא (ראו rooms/{roomCode} allow update למעלה).
        allow update: if request.auth != null && (
          (
            request.auth.uid == uid
            && request.resource.data.score is int
            && request.resource.data.wordsFound is int
            && request.resource.data.score >= resource.data.score
            && request.resource.data.wordsFound >= resource.data.wordsFound
            && request.resource.data.isHost == resource.data.isHost
            && request.resource.data.displayName == resource.data.displayName
          )
          ||
          (
            get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
            && request.resource.data.score == 0
            && request.resource.data.wordsFound == 0
            && request.resource.data.isHost == resource.data.isHost
            && request.resource.data.displayName == resource.data.displayName
          )
        );
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
