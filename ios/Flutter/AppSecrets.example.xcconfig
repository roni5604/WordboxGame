// העתיקו לקובץ AppSecrets.xcconfig (באותה תיקייה) ומלאו ערכים אמיתיים.
// הקובץ AppSecrets.xcconfig לא נשמר ב-git.

// AdMob → Apps → (אפליקציית iOS) → App settings → App ID
ADMOB_APP_ID_IOS = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

// רק אם מפעילים התחברות עם Google: הערך REVERSED_CLIENT_ID מתוך
// GoogleService-Info.plist החדש (אחרי הפעלת Google ב-Firebase Authentication)
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
