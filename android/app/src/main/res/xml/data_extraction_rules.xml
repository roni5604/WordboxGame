<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: לא מגבים ולא מעבירים בין מכשירים את נתוני האפליקציה
     (כולל אסימוני ההתחברות של Firebase). ההתקדמות נשמרת בענן לפי החשבון. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
